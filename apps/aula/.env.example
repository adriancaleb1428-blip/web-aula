# Por defecto el aula habla con el servidor propio (apps/api, PostgreSQL) a través de «/api».
# En desarrollo Vite reenvía /api a http://localhost:3001 (cámbialo con VITE_API_PROXY).

# Producción con el servidor en otro dominio:
# VITE_API_URL=https://api.tu-dominio.com/api

# Modo demo: sin servidor ni base de datos, con datos de ejemplo en el navegador.
# VITE_BACKEND=demo

# Muestra los accesos rápidos de las cuentas de ejemplo en la pantalla de ingreso (solo desarrollo).
# VITE_SHOW_DEMO_ACCOUNTS=true

# VITE_WHATSAPP_NUMBER=51950950304
